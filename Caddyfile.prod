# Production Caddyfile for Cloudflare Tunnel deployment.
# Cloudflare terminates TLS at the edge; Caddy speaks plain HTTP on :80
# and never tries Let's Encrypt against this private-IP host.

{
	# No auto-HTTPS — Cloudflare handles TLS at the edge.
	auto_https off

	# Email kept for completeness; not used since auto_https is off.
	email {$ACME_EMAIL:admin@example.com}

	log {
		output stdout
		format console
		level INFO
	}
}

http://108pog.site:80, http://www.108pog.site:80 {
	# Only the production application hostnames are accepted. The Compose host
	# port is loopback-only, so requests must arrive through the same-host
	# Cloudflare Tunnel (or an explicitly trusted local operator).

	# --- Maintenance mode --------------------------------------------------
	# Toggle by creating/removing the flag file `maintenance.on` in /etc/caddy.
	# The `file` matcher is evaluated per-request, so NO reload/restart needed.
	#   Production (Jenkins deploys ${DEPLOY_PATH}/caddy as /etc/caddy):
	#     ON : touch /opt/pji-advisor/caddy/maintenance.on
	#     OFF: rm -f  /opt/pji-advisor/caddy/maintenance.on
	#     (or run the `maintenance-toggle` Jenkins job — see Jenkinsfile.maintenance)
	#   Local (pji_caddy_config named volume):
	#     ON : docker run --rm -v pji_caddy_config:/d alpine touch /d/maintenance.on
	#     OFF: docker run --rm -v pji_caddy_config:/d alpine rm -f /d/maintenance.on
	# Scoped to the main host only — grafana.108pog.site / minio.108pog.site
	# have their own site blocks below, and jenkins.108pog.site is routed by
	# cloudflared directly, so dev subdomains keep working during maintenance.
	@maintenance {
		host 108pog.site www.108pog.site
		file {
			root /etc/caddy
			try_files maintenance.on
		}
	}
	handle @maintenance {
		root * /etc/caddy

		# Static files the maintenance page itself needs (logo, ...) — served
		# with a normal 200 so the browser renders them.
		handle /assets/* {
			file_server
		}

		handle {
			header Cache-Control "no-store"
			header Retry-After "1800"
			rewrite * /maintenance.html
			file_server {
				status 503
			}
		}
	}

	header {
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "SAMEORIGIN"
		X-XSS-Protection          "1; mode=block"
		Referrer-Policy           "strict-origin-when-cross-origin"
		Permissions-Policy        "camera=(self), microphone=(), geolocation=()"

		# Tell browsers we're served over HTTPS even though Caddy speaks HTTP
		# (Cloudflare upgraded the request).
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

		-Server
		-X-Powered-By
	}

	log {
		output stdout
		format json
		level INFO
	}

	# SSE streaming endpoints (thought-logs, notifications). Must precede the
	# generic /api/* handle. flush_interval -1 disables Caddy response buffering
	# so each event is forwarded the instant it arrives; read_timeout 0 stops
	# Caddy cutting a stream that idles between events. (Cloudflare forwards SSE
	# fine once the origin streams unbuffered with text/event-stream.)
	@sse path /api/v1/ai-recommendations/runs/*/stream /api/v1/notifications/stream /api/v1/upload-sessions/*/events
	handle @sse {
		reverse_proxy pji-backend:8085 {
			flush_interval -1
			transport http {
				dial_timeout            5s
				response_header_timeout 0
				read_timeout            0
			}
			header_up X-Real-IP          {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-For    {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-Proto  https
			header_up X-Forwarded-Host   {host}
		}
	}

	# API: /api/* → Spring Boot
	handle /api/* {
		reverse_proxy pji-backend:8085 {
			health_uri      /actuator/health
			health_interval 15s
			health_timeout  5s
			health_status   200

			transport http {
				dial_timeout            5s
				response_header_timeout 120s
				read_timeout            120s
			}

			# Trust Cloudflare's forwarded headers; pass through to backend.
			header_up X-Real-IP          {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-For    {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-Proto  https
			header_up X-Forwarded-Host   {host}
		}
	}

	# WebSocket: /ws/* → Backend
	handle /ws/* {
		reverse_proxy pji-backend:8085 {
			transport http {
				dial_timeout            5s
				response_header_timeout 0
			}
		}
	}

	# Frontend SPA
	# No active health check: the container's own healthcheck + depends_on already
	# enforce ordering. Active probes added a race where Caddy returns 503 right
	# after startup, before its first probe lands.
	handle {
		reverse_proxy pji-frontend:3000
	}

	encode {
		gzip
		zstd
	}
}

# Grafana observability UI — Caddy proxies to the Grafana container.
# Browsers see https://grafana.108pog.site (Cloudflare upgraded), Caddy receives HTTP.
http://grafana.108pog.site:80 {
	reverse_proxy grafana:3000 {
		transport http {
			dial_timeout            5s
			response_header_timeout 60s
			read_timeout            300s
		}
		header_up Host {host}
	}
}

# MinIO S3 API — public endpoint for presigned URLs from the browser
# Cloudflare terminates TLS at the edge, so Caddy speaks plain HTTP on :80.
# Browsers see https://minio.108pog.site (Cloudflare upgraded), Caddy receives HTTP.
http://minio.108pog.site:80 {
	reverse_proxy minio:9000 {
		transport http {
			dial_timeout            5s
			response_header_timeout 60s
			read_timeout            300s
		}
		# Preserve the Host header MinIO signed against — critical for AWS sig v4
		header_up Host {host}
	}
}

# Reject requests which reach the origin with an undocumented Host header.
:80 {
	respond "Misdirected Request" 421
}
