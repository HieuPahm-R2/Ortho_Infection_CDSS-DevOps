# Local development env for docker compose -f docker/docker-compose.yml --project-directory .
# Copy to Infras_Devops/.env and fill in real values.

# --- Image source ---
DOCKERHUB_REPO=local
IMAGE_TAG=dev

# --- Edge / Caddy ---
DOMAIN=localhost
ACME_EMAIL=admin@localhost

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=prod
APP_CORS_ALLOWED_ORIGINS=http://localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
UPLOAD_SESSION_PUBLIC_WEB_URL=https://108pog.site

# --- Optional trusted-LAN phone testing (docker-buildlocal.yml only) ---
# Set this to the workstation's current LAN IPv4 address, then open the frontend
# at http://<DEV_LAN_IP>:5173. Vite proxies API requests to the loopback-only
# backend; when this value is absent, MinIO also stays loopback-only.
# DEV_LAN_IP=192.168.1.20

# --- Auth ---
JWT_BASE64_SECRET=ROTATE_ME_qoAEABDke07AVLepXB4aCMtsT0wMAqR5x2VFyldsnx6e75YQkJH2UcZKTjEyoNgG71SBCXfq5N6NVZxWOfsHQ==

# --- PostgreSQL ---
POSTGRES_DB=pji_advisor
POSTGRES_USER=pji_user
POSTGRES_PASSWORD=devpass123

# --- Redis ---
REDIS_PASSWORD=devpass123

# --- RabbitMQ ---
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin2026
RABBITMQ_ERLANG_COOKIE=dev-erlang-cookie
RABBITMQ_MGMT_PORT=15672

# --- MinIO ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin12345
MINIO_BUCKET=pji-documents
MINIO_CONSOLE_PORT=9001
# Internal endpoint the backend uses for put/get/delete over the Docker network.
INTEGRATION_MINIO_URL=http://minio:9000
# Browser-facing endpoint baked into presigned image URLs. MUST be a hostname the
# browser can resolve — otherwise image previews fail with ERR_NAME_NOT_RESOLVED.
# Production: the public MinIO domain proxied by Caddy (Host header preserved so
# the AWS-SigV4 signature stays valid). Leave unset only if MinIO is reachable at
# the same URL from both backend and browser.
INTEGRATION_MINIO_PUBLIC_URL=https://minio.108pog.site
MINIO_API_CORS_ALLOW_ORIGIN=https://108pog.site

# --- AI service shared auth (backend <-> RAG) ---
AI_SERVICE_API_KEY=local-shared-key-change-me

# --- RAG (must match real provider keys) ---
OPENROUTER_API_KEY=sk-or-REPLACE_ME
QDRANT_URL=https://your-qdrant-cluster.qdrant.io
QDRANT_API_KEY=REPLACE_ME
QDRANT_COLLECTION=rag-collection
TAVILY_API_KEY=

# --- Extract Images ---
EXTRACT_QUEUE=image_processing

# --- Mail (gmail app password example) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=youraccount@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
PASSWORD_RECOVERY_MAIL_FROM=youraccount@gmail.com
DEVICE_VERIFICATION_MAIL_FROM=youraccount@gmail.com

# --- Anti-spam / CAPTCHA for email OTP forms ---
# Use real Cloudflare Turnstile keys in production.
VITE_TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
CAPTCHA_ENABLED=true
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY
CAPTCHA_CONNECT_TIMEOUT=2s
CAPTCHA_READ_TIMEOUT=3s
PASSWORD_RECOVERY_REQUEST_COOLDOWN_SECONDS=60
DEVICE_VERIFICATION_REQUEST_COOLDOWN_SECONDS=60

# --- Production alerting ---
# Create this file outside Git; see docker/observability/README.md.
DISCORD_WEBHOOK_URL_FILE=./secrets/discord_webhook_url
ALERTMANAGER_PORT=9093
